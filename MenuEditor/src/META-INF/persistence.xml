<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.1">

    <persistence-unit name="LoginPU" transaction-type="RESOURCE_LOCAL">
        <class>login.LoginData</class>
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/login_db?useLegacyDatetimeCode=false&amp;serverTimezone=UTC"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.driver" value="com.mysql.jdbc.Driver"/>
            <property name="javax.persistence.jdbc.password" value="CHANGE_ME"/>

        </properties>
    </persistence-unit>
    <persistence-unit name="MenuPU" transaction-type="RESOURCE_LOCAL">
        <class>editor.Category</class>
        <class>editor.Allergens</class>
        <class>editor.DiAl</class>
        <class>editor.DiCa</class>
        <class>editor.Dish</class>
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/menu?useLegacyDatetimeCode=false&amp;serverTimezone=UTC"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.driver" value="com.mysql.jdbc.Driver"/>
            <property name="javax.persistence.jdbc.password" value="CHANGE_ME"/>
        </properties>
    </persistence-unit>

</persistence>
